data/raw/
data/processed/
data/embeddings/
data/chroma_db/
data/eval/
data/chroma_eval/

# Notebooks — solo para prototipado, no necesarios en producción
notebooks/

# Tests — no necesarios en la imagen de producción
tests/

# Caché de Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/